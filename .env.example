# Copy to .env.local. Do not commit real keys.
# Create a secret key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Reserved for an optional Census API retrieval method. Current refresh uses public tables.
CENSUS_API_KEY=

# Optional hosted website: PostgreSQL stores shared scan results. Not needed for local development.
DATABASE_URL=
# Required for manual scans on the deployed website. Never use an OpenAI key here.
MONITOR_ADMIN_TOKEN=
# Refresh only the parcels already in the seeded permit extract.
MONITOR_REFRESH_PERMITS=false
